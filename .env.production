# Production Environment Configuration
# Copy this file to .env.local and fill in your actual values

# Application Configuration
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://recruiter-f.rnd.2bv.io
NEXT_PUBLIC_APP_IDENTIFIER=antd_recruiter

# Microsoft Azure AD Configuration
AZURE_CLIENT_ID=your-azure-client-id-here
AZURE_TENANT_ID=your-azure-tenant-id-here
NEXT_PUBLIC_AZURE_CLIENT_ID=${AZURE_CLIENT_ID}
NEXT_PUBLIC_AZURE_TENANT_ID=${AZURE_TENANT_ID}
NEXT_PUBLIC_REDIRECT_URI=https://recruiter-f.rnd.2bv.io/

# API Configuration
API_BASE_URL=https://api.your-datastore.com
API_SECRET_KEY=your-api-secret-key-here
NEXT_PUBLIC_API_BASE_URL=${API_BASE_URL}

# AI Services Configuration
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# External Integrations
TESTDOME_API_KEY=your-testdome-api-key-here
TEAMTAILOR_API_KEY=your-teamtailor-api-key-here

# Security Configuration
NEXTAUTH_SECRET=your-nextauth-secret-here-minimum-32-characters-long
NEXTAUTH_URL=https://recruiter-f.rnd.2bv.io

# Database/Datastore Configuration
DATASTORE_API_URL=https://api.your-datastore.com
DATASTORE_API_KEY=your-datastore-api-key-here

# Redis Configuration
REDIS_PASSWORD=your-redis-password-here

# Let's Encrypt Configuration (for nginx-proxy)
LETSENCRYPT_EMAIL=peter.esquilla@bemagentiq.io

# Optional: Monitoring and Logging
SENTRY_DSN=your-sentry-dsn-here
GOOGLE_ANALYTICS_ID=your-ga-id-here

# Optional: File Upload Configuration
MAX_FILE_SIZE=10MB
ALLOWED_FILE_TYPES=pdf,doc,docx,txt

# Optional: Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000