# Environment Configuration Template
# Copy this file to .env.local for local development
# Production values are in .env.production

# Application Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_IDENTIFIER=antd_recruiter

# Microsoft Azure AD Configuration
AZURE_CLIENT_ID=your-azure-client-id-here
AZURE_TENANT_ID=your-azure-tenant-id-here
NEXT_PUBLIC_AZURE_CLIENT_ID=${AZURE_CLIENT_ID}
NEXT_PUBLIC_AZURE_TENANT_ID=${AZURE_TENANT_ID}
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/auth/callback

# API Configuration
API_BASE_URL=https://your-api-endpoint.com
API_SECRET_KEY=your-api-secret-key-here
NEXT_PUBLIC_API_BASE_URL=${API_BASE_URL}

# RBAC Configuration
NEXT_PUBLIC_APP_ID=antd_recruiter
NEXT_PUBLIC_APP_NAME="Recruitment Tool"
NEXT_PUBLIC_SUPER_ADMIN_EMAILS=your-email@company.com
NEXT_PUBLIC_SUPER_ADMIN_OIDS=your-azure-ad-object-id
NEXT_PUBLIC_DEFAULT_USER_ROLE=viewer
NEXT_PUBLIC_DEFAULT_ROLE=app_viewer
NEXT_PUBLIC_ENABLE_USER_REGISTRATION=true
NEXT_PUBLIC_AUTO_PROVISION_USERS=true
NEXT_PUBLIC_REQUIRE_EXPLICIT_ACCESS=false

# Advanced Features Configuration
NEXT_PUBLIC_ENABLE_AUDIT_LOGGING=true
NEXT_PUBLIC_PERMISSION_CACHE_TTL=300000
NEXT_PUBLIC_MAX_ROLES_PER_USER=10

# AI Services Configuration
OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here

# External Integrations
TESTDOME_API_KEY=your-testdome-key-here
NEXT_PUBLIC_TESTDOME_API_KEY=${TESTDOME_API_KEY}
NEXT_PUBLIC_TESTDOME_ACCOUNT=your-testdome-account-email
TEAMTAILOR_API_KEY=your-teamtailor-key-here

# Security Configuration
NEXTAUTH_SECRET=your-nextauth-secret-32-chars-minimum
NEXTAUTH_URL=http://localhost:3000

# Database/Datastore Configuration
DATASTORE_API_URL=https://your-datastore-api.com
DATASTORE_API_KEY=your-datastore-api-key-here

# Redis Configuration (for production)
REDIS_PASSWORD=your-redis-password-here

# Let's Encrypt Configuration (for production)
LETSENCRYPT_EMAIL=your-email@company.com

# Optional: Monitoring and Logging
SENTRY_DSN=your-sentry-dsn-here
GOOGLE_ANALYTICS_ID=your-ga-id-here

# Optional: File Upload Configuration
MAX_FILE_SIZE=10MB
ALLOWED_FILE_TYPES=pdf,doc,docx,txt

# Optional: Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000